# Copy to .env.local and fill in. .env.local is gitignored.

# OpenAI API key. The server is the only place this exists — never ship it in a
# client. Used for the vision model (gpt-5.6-luna); see lib/vision-model.ts.
OPENAI_API_KEY=sk-proj-...

# Comma-separated beta tokens. Each build embeds one; drop a token from this list
# to cut that build off. Replaced by accounts + StoreKit entitlements before launch.
BETA_TOKENS=dev-local-token
